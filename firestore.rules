rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Strict rules for Dispatch Data
    match /TblDispatch/{document} {
      allow read, write: if true;
    }

    // Other known collections - maintaining existing access level (permissive)
    // You should restrict these as well based on your requirements
    match /BillTable/{document} {
      allow read, write: if true;
    }
    
    match /PaymentTable/{document} {
      allow read, write: if true;
    }
    
    match /VehicleMaster/{document} {
      allow read, write: if true;
    }

    // User profiles - each user can only read/write their own doc
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Factories - readable by any logged-in user, writable only by admins
    match /Factories/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Default deny for any other unknown collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}